# ==============================================================
# CONFIGURACIÓN DE BASE DE DATOS (Local MySQL o TiDB Cloud)
# ==============================================================

# --- OPCIÓN 1: Configuración Local (XAMPP / MySQL local) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mi_base
DB_SSL=false

# --- OPCIÓN 2: Configuración para TiDB Cloud (y Vercel Environment Variables) ---
# Copia los datos desde tu consola de TiDB Cloud:
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxx.root
# DB_PASSWORD=tu_contraseña_tidb
# DB_NAME=db_ventas
# DB_SSL=true

PORT=3001
